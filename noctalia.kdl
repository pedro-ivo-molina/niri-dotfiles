layout {

    focus-ring {
        active-color   "#b8c8de"
        inactive-color "#131315"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#b8c8de"
        inactive-color "#131315"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#b8c8de"
        inactive-color "#8897ac"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#b8c8de80"
    }
}

recent-windows {
    highlight {
        active-color "#b8c8de"
        urgent-color "#ffb4ab"
    }
}
